# Cloudflare — cabeçalhos (equivalente ao vercel.json)

# Só a ATHG (e o próprio jogo / dev local) pode exibir o jogo em iframe.
/*
  Content-Security-Policy: frame-ancestors 'self' https://athg.antonycorp11.workers.dev http://localhost:*
  X-Content-Type-Options: nosniff

/
  Cache-Control: public, max-age=0, must-revalidate

/index.html
  Cache-Control: public, max-age=0, must-revalidate

/sw.js
  Cache-Control: no-cache, no-store, must-revalidate
  Service-Worker-Allowed: /

/manifest.webmanifest
  Content-Type: application/manifest+json

/js/*
  Cache-Control: public, max-age=0, must-revalidate

/css/*
  Cache-Control: public, max-age=0, must-revalidate
